---
import '@fontsource-variable/inter';
import '../styles/global.css';
const path = Astro.url.pathname;
const cur = (href: string): 'page' | undefined => (path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined);
import { SITE_URL, SITE_NAME, CONTACT_EMAIL } from '../data/site';
import categories from '../data/categories.json';
const { title, description, schema = null, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={`${SITE_URL}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${SITE_URL}/og-image.png`} />
    {schemas.map((s) => (<script type="application/ld+json" set:html={JSON.stringify(s)} />))}
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a href="/" class="brand"><span class="mark">RT</span><span>Recruitment<b>Tools</b>.org</span></a>
        <input type="checkbox" id="navToggle" class="nav-toggle" hidden />
        <label class="nav-btn" for="navToggle" aria-label="Toggle navigation"><span></span></label>
        <nav class="primary">
          <a href="/best-recruitment-tools/" aria-current={cur("/best-recruitment-tools/")}>Best of 2026</a>
          <a href="/categories/" aria-current={cur("/categories/")}>Categories</a>
          <a href="/tools/" aria-current={cur("/tools/")}>All Tools</a>
          <a href="/stacks/" aria-current={cur("/stacks/")}>Stack Builder</a>
          <a href="/glossary/" aria-current={cur("/glossary/")}>Glossary</a>
          <a href="/this-week/" aria-current={cur("/this-week/")}>This Week</a>
          <a href="/methodology/" aria-current={cur("/methodology/")}>How We Rate</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="bottom">
      <div class="wrap">
        <div class="fcols">
          <div>
            <b>{SITE_NAME}</b>
            <p>An independent guide to the recruiting technology stack. We map every category of recruitment tool, explain what each one does, and rate the leading products so hiring teams can buy the right thing in the right order. Edited by the <a href="/about/#research-desk">Research Desk</a>. Corrections: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
          </div>
          <div>
            <b>Categories</b>
            {categories.map((c) => (<a href={`/categories/${c.slug}/`}>{c.name}</a>))}
          </div>
          <div>
            <b>Guides</b>
            <a href="/best-recruitment-tools/">Best recruitment tools 2026</a>
            <a href="/stacks/">Recruiting stacks by company type</a>
            <a href="/tools/">Tool directory</a>
            <a href="/glossary/">Recruiting tech glossary</a>
            <a href="/this-week/">This week in recruiting tools</a>
            <a href="/switching/">Switching guides</a>
            <a href="/methodology/">Rating methodology</a>
          </div>
          <div>
            <b>Site</b>
            <a href="/about/">About</a>
            <a href="/authors/">Our writers</a>
            <a href="/contact/">Contact</a>
            <a href="/privacy/">Privacy</a>
            <a href="/llms.txt">llms.txt</a>
            <a href="/sitemap-index.xml">Sitemap</a>
          </div>
        </div>
        <div class="featured-on" aria-label="Directories featuring RecruitmentTools.org">
          <a href="https://superlaunchlist.com?ref=https%3A%2F%2Frecruitmenttools.org" target="_blank" rel="noopener"><img src="https://superlaunchlist.com/badge.svg" width="174" height="42" alt="Featured on SuperLaunch List" loading="lazy" /></a>
         <a href="https://smollaunch.com" target="_blank" rel="noopener"><img src="https://smollaunch.com/badges/featured.svg" width="250" height="60" alt="RecruitmentTools.org: Featured on Smol Launch" loading="lazy" /></a>
          <a href="https://www.scrolllaunch.com/products/recruitmenttools-org?ref=badge" target="_blank" rel="noopener"><img src="https://www.scrolllaunch.com/api/badge/recruitmenttools-org?variant=launched&theme=light" width="220" height="48" alt="RecruitmentTools.org - Featured on ScrollLaunch" loading="lazy" /></a>
          <a href="https://deeplaunch.io" target="_blank" rel="noopener"><img src="https://deeplaunch.io/badge/badge_light.svg" width="200" height="54" alt="Featured on DeepLaunch.io" loading="lazy" /></a>
          <a href="https://tooldirs.com" target="_blank" rel="noopener"><img src="https://tooldirs.com/badge/badge_light.svg" width="200" height="54" alt="Featured on ToolDirs" loading="lazy" /></a>
          <a href="https://firstlook.tools" target="_blank" rel="noopener"><img src="https://firstlook.tools/badge/badge_light.svg" width="200" height="54" alt="Featured on First Look" loading="lazy" /></a>
          <a href="https://gets.tools" target="_blank" rel="noopener"><img src="https://gets.tools/badge/badge_light.svg" width="200" height="54" alt="Featured on Gets.Tools" loading="lazy" /></a>
          <a href="https://launchaf.com/" target="_blank" rel="noopener" data-launchaf-badge="true"><img src="https://launchaf.com/api/badge/light?v=launchaf-blue-2026-2" width="200" height="56" alt="Featured on LaunchAF" loading="lazy" /></a>
          <a href="https://fazier.com" target="_blank" rel="noopener"><img src="https://fazier.com/api/v1//public/badges/launch_badges.svg?badge_type=featured&theme=light" width="200" height="43" alt="Featured on Fazier" loading="lazy" /></a>
        </div>
        <p class="listed-on">Listed on <a href="https://www.aitoolzdir.com" target="_blank" rel="noopener">AI Toolz Dir</a> · <a href="https://aitooltrek.com" target="_blank" rel="noopener">AI Tool Trek</a> · <a href="https://aitop10.tools/" target="_blank" rel="noopener">AiTop10 Tools</a> · <a href="https://develif.com/s/recruitmenttoolsorg" target="_blank" rel="noopener">DevElif</a></p>
        <div class="legal">© 2026 {SITE_NAME}. Vendor names and logos belong to their owners. We do not accept payment for placement; see <a href="/methodology/">how we rate</a>.</div>
      </div>
    </footer>
  </body>
</html>
