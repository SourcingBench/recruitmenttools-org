---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { SITE_URL, fmtDate } from '../../data/site';
import categories from '../../data/categories.json';
import stacks from '../../data/stacks.json';
import agencies from '../../data/agencies.json';
import compare from '../../data/compare.json';
import switching from '../../data/switching.json';
import definitions from '../../data/definitions.json';
import roundups from '../../data/roundups.json';
import tools from '../../data/tools.json';
import { WRITERS, writerFor, personLd } from '../../data/writers';
const tn = Object.fromEntries(tools.map((t) => [t.slug, t.name]));
const ALL = [{ path: '/best-recruitment-tools/', name: 'Best recruitment tools 2026' }, { path: '/best-ai-recruitment-tools/', name: 'Best AI recruitment tools 2026' }, ...categories.map((c) => ({ path: `/categories/${c.slug}/`, name: `Best ${c.plural}` })), ...stacks.map((s) => ({ path: `/stacks/${s.slug}/`, name: s.title })), ...(agencies as any[]).map((x) => ({ path: `/agencies/${x.slug}/`, name: x.h1, date: x.date ?? x.updated })), ...(compare as any[]).map((x) => ({ path: `/compare/${x.a}-vs-${x.b}/`, name: `${tn[x.a]} vs ${tn[x.b]}`, date: x.date ?? x.updated })), ...(switching as any[]).map((x) => ({ path: `/switching/${x.slug}/`, name: x.title, date: x.date ?? x.updated })), ...(definitions as any[]).map((x) => ({ path: `/what-is/${x.slug}/`, name: x.question, date: x.date ?? x.updated })), ...(roundups as any[]).map((x) => ({ path: `/this-week/${x.slug}/`, name: x.title, date: x.date ?? x.updated })), ...tools.map((t) => ({ path: `/tools/${t.slug}/`, name: `${t.name} review` }))] as { path: string; name: string; date?: string }[];
export function getStaticPaths() { return WRITERS.map((w) => ({ params: { slug: w.slug }, props: { w } })); }
const { w } = Astro.props as any;
const mine = ALL.filter((p) => writerFor(p.path).slug === w.slug).sort((x, y) => (y.date ?? '').localeCompare(x.date ?? ''));
const schema = [{ '@context': 'https://schema.org', '@type': 'ProfilePage', mainEntity: { ...personLd(w), description: w.bio } }];
---
<Base title={`${w.name}, Writer | RecruitmentTools.org`} description={w.bio} schema={schema}>
  <PageHead byline={false} title={w.name} crumbs={[{ name: 'Home', path: '/' }, { name: 'Writers', path: '/authors/' }, { name: w.name, path: `/authors/${w.slug}/` }]} />
  <div class="wrap single narrow">
      <p>{w.bio}</p>
      <h2>Pages by {w.name}</h2>
      <ul>{mine.map((m) => <li><a href={m.path}>{m.name}</a>{m.date && <> ({fmtDate(m.date)})</>}</li>)}</ul>
      <p><a href="/authors/">All writers</a></p>
  </div>
</Base>
